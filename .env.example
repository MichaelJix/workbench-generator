HOST=127.0.0.1
PORT=3080
WORKBENCH_DATABASE=./data/workbench.db
WORKBENCH_MASTER_KEY=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:3080,http://127.0.0.1:3080
PUBLIC_BASE_URL=http://127.0.0.1:3080
ALLOW_PRIVATE_UPSTREAM=false
OAUTH_PROVIDERS_JSON={}

# 首次初始化 CLI 使用，执行后应从环境中移除
WORKBENCH_ADMIN_PASSWORD=replace-with-a-strong-password
